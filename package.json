{
  "name": "business-platform",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24.22.0 <25"
  },
  "scripts": {
    "dev:infra": "docker compose --env-file .env -f infra/compose/compose.dev.yml up -d",
    "dev:infra:down": "docker compose --env-file .env -f infra/compose/compose.dev.yml down",
    "db:migrate": "pnpm --filter @bp/db migrate:dev",
    "db:deploy": "pnpm --filter @bp/db migrate:deploy",
    "db:reset:test": "node tools/reset-test-db.mjs",
    "db:seed": "pnpm --filter @bp/db seed",
    "dev": "node tools/dev-stack.mjs",
    "dev:api": "pnpm --filter @bp/api dev",
    "dev:worker": "pnpm --filter @bp/api dev:worker",
    "demo:import-fixtures": "tsx --conditions=bp-source --tsconfig apps/api/tsconfig.json apps/api/src/demo-import-fixtures.ts",
    "dev:web": "PORT=4200 nx serve web",
    "lint": "nx run-many -t lint",
    "typecheck": "nx run-many -t typecheck",
    "test": "nx run-many -t test",
    "test:integration": "node tools/test-integration.mjs",
    "test:e2e": "node tools/e2e.mjs",
    "build": "nx run-many -t build",
    "postinstall": "pnpm --filter @bp/db generate",
    "setup:env": "node tools/setup-env.mjs",
    "milestone:verify": "tsx tools/milestone/verify.ts",
    "milestone:csp": "tsx tools/milestone/csp-check.ts",
    "openapi:export": "pnpm --filter @bp/api openapi:export"
  },
  "devDependencies": {
    "@angular-devkit/core": "22.2.3",
    "@angular-devkit/schematics": "22.2.3",
    "@angular/build": "22.2.3",
    "@angular/cli": "22.2.3",
    "@angular/compiler-cli": "22.2.3",
    "@angular/language-service": "22.2.3",
    "@eslint/js": "9.39.5",
    "@nx/angular": "23.3.0",
    "@nx/devkit": "23.3.0",
    "@nx/eslint": "23.3.0",
    "@nx/eslint-plugin": "23.3.0",
    "@nx/js": "23.3.0",
    "@nx/nest": "23.3.0",
    "@nx/playwright": "23.3.0",
    "@nx/web": "23.3.0",
    "@playwright/test": "1.64.1",
    "@schematics/angular": "22.2.3",
    "@swc/core": "1.16.18",
    "@swc/helpers": "0.5.23",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@typescript-eslint/utils": "8.71.2",
    "angular-eslint": "22.6.0",
    "dotenv": "18.0.8",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-playwright": "1.8.3",
    "jsdom": "27.4.0",
    "nx": "23.3.0",
    "pg": "8.23.1",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "undici": "7.29.0",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@angular/cdk": "22.2.3",
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@angular/router": "22.2.3",
    "@jsverse/transloco": "8.4.0",
    "@primeuix/themes": "2.0.3",
    "primeicons": "7.0.0",
    "primeng": "21.1.10",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  }
}
