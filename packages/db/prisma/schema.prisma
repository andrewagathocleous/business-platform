  connection          StoreConnection   @relation(fields: [companyId, connectionId], references: [companyId, id])
  externalId          String            @map("external_id")
  externalNumber      String            @map("external_number")
  sourcePlatform      StorePlatform     @map("source_platform")
  sourceStatus        Json              @map("source_status") @db.JsonB
  sourceCreatedAt     DateTime?         @map("source_created_at") @db.Timestamptz(6)
  sourceUpdatedAt     DateTime?         @map("source_updated_at") @db.Timestamptz(6)
  paymentStatus       PaymentStatus     @map("payment_status")
  fulfilmentStatus    FulfilmentStatus  @map("fulfilment_status")
  integrationStatus   IntegrationStatus @map("integration_status")
  reviewReason        String?           @map("review_reason")
  attentionReasons    String[]          @default([]) @map("attention_reasons")
  customer            Json?             @db.JsonB
  recipient           Json?             @db.JsonB
  billingAddress      Json?             @map("billing_address") @db.JsonB
  deliveryMethod      DeliveryMethod    @map("delivery_method")
  shippingLine        Json?             @map("shipping_line") @db.JsonB
