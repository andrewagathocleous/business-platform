/// line_height is not specified in the plan. The seed uses 1.2.
model GiftMessageTemplate {
  id             String             @id @default(uuid(7)) @db.Uuid
  companyId      String             @map("company_id") @db.Uuid
  company        Company            @relation(fields: [companyId], references: [id])
  name           String
  pageWidthMm    Decimal            @map("page_width_mm") @db.Decimal(6, 2)
  pageHeightMm   Decimal            @map("page_height_mm") @db.Decimal(6, 2)
  marginTopMm    Decimal            @map("margin_top_mm") @db.Decimal(6, 2)
  marginRightMm  Decimal            @map("margin_right_mm") @db.Decimal(6, 2)
  marginBottomMm Decimal            @map("margin_bottom_mm") @db.Decimal(6, 2)
  marginLeftMm   Decimal            @map("margin_left_mm") @db.Decimal(6, 2)
  fontSizePt     Decimal            @map("font_size_pt") @db.Decimal(6, 2)
  minFontSizePt  Decimal            @map("min_font_size_pt") @db.Decimal(6, 2)
  lineHeight     Decimal            @map("line_height") @db.Decimal(6, 3)
  align          GiftAlign
  verticalAlign  GiftVerticalAlign  @map("vertical_align")
  isDefault      Boolean            @default(false) @map("is_default")
  // One default per company is gift_message_template_one_default_key
  // (company_id WHERE is_default) in migration SQL. Prisma cannot model
  // that predicate, so the index is not declared here.

  @@map("gift_message_template")
}

model Printer {
  id                String          @id @default(uuid(7)) @db.Uuid
  companyId         String          @map("company_id") @db.Uuid
  company           Company         @relation(fields: [companyId], references: [id])
  locationId        String          @map("location_id") @db.Uuid
  location          Location        @relation(fields: [companyId, locationId], references: [companyId, id])
  provider          PrinterProvider
  externalPrinterId String          @map("external_printer_id")
  name              String
  description       String?
  paperSizes        String[]        @map("paper_sizes")
  status            PrinterStatus   @default(unknown)
  lastSeenAt        DateTime?       @map("last_seen_at") @db.Timestamptz(6)

  mappings PrinterMapping[]
  jobs     PrintJob[]

  @@unique([companyId, id])
  // Discovery upserts on this identity. One provider printer per company.
  @@unique([companyId, provider, externalPrinterId])
  @@map("printer")
}

model PrinterMapping {
  id           String            @id @default(uuid(7)) @db.Uuid
  companyId    String            @map("company_id") @db.Uuid
  company      Company           @relation(fields: [companyId], references: [id])
  locationId   String            @map("location_id") @db.Uuid
  location     Location          @relation(fields: [companyId, locationId], references: [companyId, id])
  documentType PrintDocumentType @map("document_type")
  printerId    String            @map("printer_id") @db.Uuid
  printer      Printer           @relation(fields: [companyId, printerId], references: [companyId, id])
  paperSize    String            @map("paper_size")
  copies       Int               @default(1)

  @@unique([companyId, locationId, documentType])
  @@map("printer_mapping")
}

model PrintJob {
  id              String            @id @default(uuid(7)) @db.Uuid
  companyId       String            @map("company_id") @db.Uuid
  company         Company           @relation(fields: [companyId], references: [id])
  printerId       String            @map("printer_id") @db.Uuid
  printer         Printer           @relation(fields: [companyId, printerId], references: [companyId, id])
  documentType    PrintDocumentType @map("document_type")
  sourceType      PrintSourceType   @map("source_type")
  sourceId        String            @map("source_id") @db.Uuid
  sourceVersion   Int               @map("source_version")
  fileId          String?           @map("file_id") @db.Uuid
  file            StoredFile?       @relation(fields: [companyId, fileId], references: [companyId, id])
  copies          Int               @default(1)
  paperSize       String            @map("paper_size")
  status          PrintJobStatus    @default(queued)
  isReprint       Boolean           @default(false) @map("is_reprint")
  reprintOfId     String?           @map("reprint_of_id") @db.Uuid
  reprintOf       PrintJob?         @relation("Reprint", fields: [companyId, reprintOfId], references: [companyId, id])
  reprints        PrintJob[]        @relation("Reprint")
  reprintReason   String?           @map("reprint_reason")
  idempotencyKey  String            @map("idempotency_key")
  providerJobId   String?           @map("provider_job_id")
  providerState   String?           @map("provider_state")
  requestedById   String            @map("requested_by") @db.Uuid
  requestedBy     UserAccount       @relation("PrintRequestedBy", fields: [requestedById], references: [id])
  queueJobId      String?           @map("queue_job_id") @db.Uuid
  queueJob        Job?              @relation(fields: [companyId, queueJobId], references: [companyId, id])
  attempts        Int               @default(0)
  lastError       String?           @map("last_error")
  correlationId   String            @map("correlation_id")
  submittedAt     DateTime?         @map("submitted_at") @db.Timestamptz(6)
  completedAt     DateTime?         @map("completed_at") @db.Timestamptz(6)
  confirmedById   String?           @map("confirmed_by") @db.Uuid
  confirmedBy     UserAccount?      @relation("PrintConfirmedBy", fields: [confirmedById], references: [id])
  confirmedAt     DateTime?         @map("confirmed_at") @db.Timestamptz(6)
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([companyId, id])
  @@unique([companyId, idempotencyKey])
  @@map("print_job")
}

