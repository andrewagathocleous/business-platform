# Local development variables. `pnpm setup:env` copies this file to .env (gitignored)
# and replaces every value that is exactly `generate` with a random local secret.
# It never overwrites an existing .env. Do not put real secrets in this file.

# development | test | uat | production. Security toggles follow APP_ENV, not NODE_ENV.
APP_ENV=development

# Superuser for the local Postgres container only. Application code does not use it.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=generate

# bp_owner runs migrations and the seed. CREATEDB is granted only by the dev init script.
BP_OWNER_PASSWORD=generate
# bp_app is the runtime role: NOSUPERUSER, NOBYPASSRLS. API, worker and integration tests use it.
BP_APP_PASSWORD=generate
# Owns the n8n database and nothing else.
N8N_DB_PASSWORD=generate

# Runtime connection (bp_app) and migration connection (bp_owner).
DATABASE_URL=postgresql://bp_app:${BP_APP_PASSWORD}@127.0.0.1:5432/business_platform
DATABASE_URL_OWNER=postgresql://bp_owner:${BP_OWNER_PASSWORD}@127.0.0.1:5432/business_platform
# Integration tests use the disposable test database, not the seeded dev database.
DATABASE_URL_TEST=postgresql://bp_app:${BP_APP_PASSWORD}@127.0.0.1:5432/business_platform_test
DATABASE_URL_OWNER_TEST=postgresql://bp_owner:${BP_OWNER_PASSWORD}@127.0.0.1:5432/business_platform_test

# n8n credential encryption key. Local random value only.
N8N_ENCRYPTION_KEY=generate
# Shared secret between n8n and the external task runner.
N8N_RUNNERS_AUTH_TOKEN=generate

# Loopback ports published by infra/compose/compose.dev.yml.
POSTGRES_PORT=5432
N8N_PORT=5678

# API listen address. Defaults to 127.0.0.1. A container sets 0.0.0.0.
HOST=127.0.0.1
# API listen port.
PORT=3000

# Requests allowed per 60 seconds for one client. Unset uses these defaults.
THROTTLE_DEFAULT_LIMIT=300
THROTTLE_AUTH_LIMIT=20
THROTTLE_AUTOMATION_LIMIT=120

# Honoured only when APP_ENV is development or test.
# uat and production refuse to start when this is true.
AUTH_DEV_LOGIN_ENABLED=true

# Secure session cookies. uat and production refuse to start when this is false.
SESSION_COOKIE_SECURE=false

# HMAC key for the CSRF cookie. `generate` becomes a random local secret.
CSRF_SECRET=generate

# Unset defaults to true in uat and production, and false in development and test.
AUTH_REQUIRE_MFA_FOR_PRIVILEGED=

# Entra OIDC. Optional in development and test. Required, and not placeholders, in uat and production.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=

# JSON map of key id to a base64-encoded 32-byte key. The active id names the key used for new ciphertext.
# `generate` becomes {"k1":"<random 32 bytes>"}.
APP_MASTER_KEYS=generate
APP_MASTER_KEY_ACTIVE=k1
