# Local development variables. `pnpm setup:env` copies this file to .env (gitignored)
# and replaces every value that is exactly `generate` with a random local secret.
# It never overwrites an existing .env. Do not put real secrets in this file.

# development | test | uat | production. Security toggles follow APP_ENV, not NODE_ENV.
APP_ENV=development

# Superuser for the local Postgres container only. Application code does not use it.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=generate

# bp_owner runs migrations and the seed. CREATEDB is granted only by the dev init script.
BP_OWNER_PASSWORD=generate
# bp_app is the runtime role: NOSUPERUSER, NOBYPASSRLS. API, worker and integration tests use it.
BP_APP_PASSWORD=generate
# Owns the n8n database and nothing else.
N8N_DB_PASSWORD=generate

# Runtime connection (bp_app) and migration connection (bp_owner).
DATABASE_URL=postgresql://bp_app:${BP_APP_PASSWORD}@127.0.0.1:5432/business_platform
DATABASE_URL_OWNER=postgresql://bp_owner:${BP_OWNER_PASSWORD}@127.0.0.1:5432/business_platform
# Integration tests use the disposable test database, not the seeded dev database.
DATABASE_URL_TEST=postgresql://bp_app:${BP_APP_PASSWORD}@127.0.0.1:5432/business_platform_test
DATABASE_URL_OWNER_TEST=postgresql://bp_owner:${BP_OWNER_PASSWORD}@127.0.0.1:5432/business_platform_test

# n8n credential encryption key. Local random value only.
N8N_ENCRYPTION_KEY=generate
# Shared secret between n8n and the external task runner.
N8N_RUNNERS_AUTH_TOKEN=generate

# Loopback ports published by infra/compose/compose.dev.yml.
POSTGRES_PORT=5432
N8N_PORT=5678

# API listen address. Defaults to 127.0.0.1. A container sets 0.0.0.0.
HOST=127.0.0.1
# API listen port.
PORT=3000

# Requests allowed per 60 seconds for one client. Unset uses these defaults.
THROTTLE_DEFAULT_LIMIT=300
THROTTLE_AUTH_LIMIT=20
THROTTLE_AUTOMATION_LIMIT=120

# Honoured only when APP_ENV is development or test.
# uat and production refuse to start when this is true.
AUTH_DEV_LOGIN_ENABLED=true

# Secure session cookies. uat and production refuse to start when this is false.
SESSION_COOKIE_SECURE=false

# HMAC key for the CSRF cookie. `generate` becomes a random local secret.
CSRF_SECRET=generate

# Unset defaults to true in uat and production, and false in development and test.
AUTH_REQUIRE_MFA_FOR_PRIVILEGED=

# Entra OIDC. Optional in development and test. Required, and not placeholders, in uat and production.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=

# JSON map of key id to a base64-encoded 32-byte key. The active id names the key used for new ciphertext.
# `generate` becomes {"k1":"<random 32 bytes>"}.
APP_MASTER_KEYS=generate
APP_MASTER_KEY_ACTIVE=k1

# Directories for stored document bytes and simulated print PDFs. A relative
# path resolves from the repository root (the directory that contains
# pnpm-workspace.yaml), not from the process working directory. Created on
# write. These are not secrets.
STORAGE_ROOT=var/storage
MOCK_PRINT_ROOT=var/mock-print-output

# Production and UAT do not use this file. `infra/compose/compose.prod.yml` reads
# env files from ${BP_ENV_DIR}. Compose requires that variable and has no default.
# The runbook path is /opt/business-platform/env. Those files are not in the repo.
# Placeholders only; do not put real secrets here.
# `pnpm setup:env` ignores this comment block. Compose interpolation uses
# BP_ENV_DIR and BP_IMAGE_TAG from the shell, not from these files.
#
# postgres.env
#   POSTGRES_USER=postgres
#   POSTGRES_PASSWORD=replace-me
#   POSTGRES_DB=postgres
#   BP_OWNER_PASSWORD=replace-me
#   BP_APP_PASSWORD=replace-me
#   N8N_DB_PASSWORD=replace-me
#   BP_OWNER_CREATEDB is forced off by compose. Do not grant CREATEDB.
#
# migrate.env
#   DATABASE_URL_OWNER=postgresql://bp_owner:replace-me@postgres:5432/business_platform
#
# api.env  (the api and the worker)
#   APP_ENV=production
#   DATABASE_URL=postgresql://bp_app:replace-me@postgres:5432/business_platform
#   CSRF_SECRET=replace-me
#   APP_MASTER_KEYS={"k1":"replace-me"}
#   APP_MASTER_KEY_ACTIVE=k1
#   OIDC_ISSUER=https://login.microsoftonline.com/replace-me/v2.0
#   OIDC_CLIENT_ID=replace-me
#   OIDC_CLIENT_SECRET=replace-me
#   OIDC_REDIRECT_URI=https://app.example.test/api/auth/oidc/callback
#   STORAGE_ROOT=/var/lib/business-platform/storage
#   MOCK_PRINT_ROOT=/var/lib/business-platform/mock-print
#   AUTH_DEV_LOGIN_ENABLED=false
#   SESSION_COOKIE_SECURE=true
#   AUTH_REQUIRE_MFA_FOR_PRIVILEGED=true
#   HOST=0.0.0.0
#   PORT=3000
#   TRUST_PROXY_HOPS=0
#   0 trusts nothing. compose.prod.yml sets TRUST_PROXY_HOPS=1 on the api because
#   Caddy is one hop and does not use trusted_proxies.
#   uat and production refuse to start with the dev login on or with insecure cookies.
#   Compose also sets AUTH_DEV_LOGIN_ENABLED=false and SESSION_COOKIE_SECURE=true.
#   The API sends HSTS only when APP_ENV is uat or production.
#
# n8n.env
#   DB_POSTGRESDB_PASSWORD=replace-me
#   N8N_ENCRYPTION_KEY=replace-me
#   N8N_RUNNERS_AUTH_TOKEN=replace-me
#   DB_POSTGRESDB_PASSWORD must be the same value as N8N_DB_PASSWORD in postgres.env.
#   Do not set N8N_SECURE_COOKIE=false in production. The dev stack sets it only
#   because the editor is plain HTTP on loopback.
#
# n8n-runner.env
#   N8N_RUNNERS_AUTH_TOKEN=replace-me
#   The same value as N8N_RUNNERS_AUTH_TOKEN in n8n.env. The runner loads only
#   this file. It does not receive the database password or N8N_ENCRYPTION_KEY.
#
# caddy.env
#   APP_DOMAIN=app.example.test
#   ACME_EMAIL=ops@example.test
